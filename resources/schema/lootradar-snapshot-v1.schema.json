{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LootRadar Snapshot v1",
  "description": "Contrato público entre o LootRadar Core e seus consumidores Web/Desktop.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producerVersion",
    "generatedAt",
    "context",
    "data",
    "complete",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "producerVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "locale", "currency", "minimumScore"],
      "properties": {
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^(?:native|[A-Z]{3})$"
        },
        "minimumScore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeGames", "deals"],
      "properties": {
        "freeGames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gameDeal"
          }
        },
        "deals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gameDeal"
          }
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeGames", "deals"],
      "properties": {
        "freeGames": {
          "$ref": "#/$defs/sourceStatus"
        },
        "deals": {
          "$ref": "#/$defs/sourceStatus"
        }
      }
    }
  },
  "$defs": {
    "sourceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete"],
      "properties": {
        "complete": {
          "type": "boolean"
        }
      }
    },
    "gameDeal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "storeName",
        "originalPrice",
        "currentPrice",
        "checkoutUrl",
        "approvalRating",
        "isFree",
        "currency",
        "expiresAt",
        "historicalLow",
        "discountPercentage",
        "isAtHistoricalLow"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "storeName": {
          "type": "string"
        },
        "originalPrice": {
          "type": "number",
          "minimum": 0
        },
        "currentPrice": {
          "type": "number",
          "minimum": 0
        },
        "checkoutUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "approvalRating": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "isFree": {
          "type": "boolean"
        },
        "currency": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{3}$"
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "historicalLow": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "discountPercentage": {
          "type": "integer"
        },
        "isAtHistoricalLow": {
          "type": "boolean"
        }
      }
    }
  }
}
