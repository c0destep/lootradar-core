#!/usr/bin/env php
<?php

declare(strict_types=1);

use LootRadar\Cli\ApplicationFactory;
use LootRadar\Cli\EnvironmentLoader;
use Symfony\Component\Dotenv\Exception\ExceptionInterface as DotenvExceptionInterface;

// Resolve o autoloader tanto em uso standalone quanto como dependência.
$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloaded = false;
foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        $autoloaded = true;
        break;
    }
}

if (!$autoloaded) {
    fwrite(STDERR, "Não foi possível localizar o autoloader do Composer. Execute composer install.\n");
    exit(1);
}

try {
    $composerAutoloadPath = $GLOBALS['_composer_autoload_path'] ?? null;
    EnvironmentLoader::loadForBinary(
        dirname(__DIR__),
        is_string($composerAutoloadPath) ? $composerAutoloadPath : null,
    );
} catch (DotenvExceptionInterface) {
    fwrite(STDERR, "Não foi possível carregar o arquivo .env. Verifique sua sintaxe.\n");
    exit(1);
}

exit(ApplicationFactory::create()->run());
