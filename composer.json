{
  "name": "lootradar/lootradar",
  "description": "Motor agnóstico de busca e monitoramento de jogos gratuitos e promoções.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/c0destep/lootradar-core",
  "authors": [
    {
      "name": "c0destep",
      "homepage": "https://github.com/c0destep",
      "role": "Developer"
    }
  ],
  "keywords": [
    "cli",
    "deals",
    "epic-games",
    "free-games",
    "games",
    "gog",
    "isthereanydeal",
    "price-history",
    "steam"
  ],
  "support": {
    "issues": "https://github.com/c0destep/lootradar-core/issues",
    "source": "https://github.com/c0destep/lootradar-core"
  },
  "archive": {
    "exclude": [
      "/.agents/",
      "/.claude/",
      "/.codex/",
      "/.env*",
      "!/.env.example",
      "/.git/",
      "/.github/",
      "/.idea/",
      "/.phpstan.cache/",
      "/.phpunit.cache/",
      "/.vscode/",
      "/dist/",
      "/storage/",
      "/tests/",
      "/var/",
      "/vendor/",
      "/AGENTS.md",
      "/LootRadar.md",
      "/Plano de Desenvolvimento.md",
      "/ROADMAP.md",
      "/lootradar-specs.md",
      "/phpstan.neon",
      "/phpunit.xml",
      "/skills-lock.json",
      "*.lrcache.json",
      "*.lrcache.json.gz",
      "*.sqlite",
      "*.sqlite3"
    ]
  },
  "autoload": {
    "psr-4": {
      "LootRadar\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LootRadar\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.5",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-uri": "*",
    "ext-zlib": "*",
    "guzzlehttp/guzzle": "^7",
    "nunomaduro/termwind": "^2",
    "symfony/console": "^7",
    "symfony/dotenv": "^7"
  },
  "require-dev": {
    "pestphp/pest": "^3",
    "phpstan/phpstan": "^2"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "scripts": {
    "lint": [
      "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
      "php -l bin/lootradar"
    ],
    "test": "vendor/bin/pest",
    "analyse": "vendor/bin/phpstan analyse src --level=5 --debug --memory-limit=512M",
    "check:package": [
      "composer validate --strict",
      "composer check-platform-reqs",
      "@lint",
      "@test",
      "@analyse",
      "composer audit --locked --abandoned=fail"
    ]
  },
  "bin": [
    "bin/lootradar"
  ]
}
